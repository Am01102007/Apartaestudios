# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
# Obligatorio: si falta, la API asume producción y exige una configuración segura.
APP_ENTORNO=desarrollo

# Conexión a PostgreSQL: postgresql+psycopg://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
# Rol con que se conecta la API. Lo recomendado es apartaestudios_app (scripts/roles.sql),
# que no puede alterar la estructura ni la auditoría.
APP_DATABASE_URL=postgresql+psycopg://apartaestudios:apartaestudios@localhost:5432/apartaestudios
# Rol dueño de las tablas, solo para `alembic upgrade`. Si no se define, se usa el de arriba.
# APP_DATABASE_URL_MIGRACIONES=postgresql+psycopg://apartaestudios:apartaestudios@localhost:5432/apartaestudios
# Base exclusiva para las pruebas de integración; se borra y recrea en cada ejecución.
# Su nombre debe terminar en _test.
APP_DATABASE_URL_PRUEBAS=postgresql+psycopg://apartaestudios:apartaestudios@localhost:5432/apartaestudios_test

APP_DOCS_HABILITADAS=true

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si no la defines, en desarrollo se usa una clave de prueba; en producción es obligatoria.
# APP_CLAVE_JWT=

# La cookie de sesión solo viaja por HTTPS. Los navegadores aceptan http://localhost, pero
# herramientas como Postman no: para probar con ellas en tu PC, pon false. Nunca en producción.
APP_COOKIE_SEGURA=true
